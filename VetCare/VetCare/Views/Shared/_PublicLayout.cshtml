<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="bg-white border-bottom mb-4">
        <div class="container py-3"><span class="fs-4 fw-semibold text-primary">VetCare</span><span class="text-muted ms-2">Citas veterinarias</span></div>
    </header>
    <main class="container pb-5">@RenderBody()</main>
    <footer class="border-top bg-white text-muted"><div class="container py-3">VetCare · Atención veterinaria</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
