@model VetCare.Models.MedicalRecord
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="PetId" class="form-label">Mascota</label><select asp-for="PetId" asp-items="ViewBag.PetId" class="form-select"><option value="">Seleccione...</option></select></div><div class="mb-3"><label asp-for="ConsultationDate" class="form-label">Fecha de consulta</label><input asp-for="ConsultationDate" class="form-control" /></div><div class="mb-3"><label asp-for="Symptoms" class="form-label">Síntomas</label><textarea asp-for="Symptoms" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Diagnosis" class="form-label">Diagnóstico</label><textarea asp-for="Diagnosis" class="form-control"></textarea><span asp-validation-for="Diagnosis" class="text-danger"></span></div><div class="mb-3"><label asp-for="Treatment" class="form-label">Tratamiento</label><textarea asp-for="Treatment" class="form-control"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="RecordedWeight" class="form-label">Peso registrado (kg)</label><input asp-for="RecordedWeight" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="NextReviewDate" class="form-label">Próxima revisión</label><input asp-for="NextReviewDate" class="form-control" /></div></div><div class="mb-3"><label asp-for="Notes" class="form-label">Notas</label><textarea asp-for="Notes" class="form-control"></textarea></div>
