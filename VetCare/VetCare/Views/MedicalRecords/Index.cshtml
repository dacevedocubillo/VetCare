@model IEnumerable<VetCare.Models.MedicalRecord>
@{ ViewData["Title"] = "Historiales médicos"; }
<div class="d-flex justify-content-between mb-3"><div><h1>Historiales médicos</h1><p class="text-muted">Consultas, diagnósticos y tratamientos.</p></div><a asp-action="Create" class="btn btn-primary align-self-start">Registrar consulta</a></div>@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
<table class="table table-hover"><thead><tr><th>Fecha</th><th>Mascota</th><th>Propietario</th><th>Diagnóstico</th><th>Tratamiento</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ConsultationDate.ToString("dd/MM/yyyy")</td><td>@item.Pet.Name</td><td>@item.Pet.Owner.FullName</td><td>@item.Diagnosis</td><td>@item.Treatment</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este historial?')">Eliminar</button></form></td></tr> }</tbody></table>
