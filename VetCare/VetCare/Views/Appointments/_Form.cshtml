@model VetCare.Models.Appointment
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="PetId" class="form-label">Mascota</label><select asp-for="PetId" asp-items="ViewBag.PetId" class="form-select"><option value="">Seleccione...</option></select></div><div class="mb-3"><label asp-for="ScheduledAt" class="form-label">Fecha y hora</label><input asp-for="ScheduledAt" class="form-control" /></div><div class="mb-3"><label asp-for="Reason" class="form-label">Motivo</label><textarea asp-for="Reason" class="form-control"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div><div class="mb-3"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select"><option>Programada</option><option>Confirmada</option><option>Completada</option><option>Cancelada</option></select></div><div class="mb-3"><label asp-for="Notes" class="form-label">Notas</label><textarea asp-for="Notes" class="form-control"></textarea></div>
