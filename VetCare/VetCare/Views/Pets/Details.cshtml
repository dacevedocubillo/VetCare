@model VetCare.Models.Pet
@{ ViewData["Title"] = "Detalle de mascota"; }
<div class="d-flex justify-content-between"><div><h1>@Model.Name</h1><p class="text-muted">@Model.Species · @Model.Breed</p></div><div><a asp-controller="Appointments" asp-action="Create" asp-route-petId="@Model.Id" class="btn btn-primary">Agendar cita</a> <a asp-controller="MedicalRecords" asp-action="Create" asp-route-petId="@Model.Id" class="btn btn-success">Agregar historial</a></div></div>
<dl class="row"><dt class="col-sm-3">Propietario</dt><dd class="col-sm-9">@Model.Owner.FullName</dd><dt class="col-sm-3">Nacimiento</dt><dd class="col-sm-9">@Model.BirthDate?.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Peso</dt><dd class="col-sm-9">@Model.Weight kg</dd><dt class="col-sm-3">Alergias</dt><dd class="col-sm-9">@(Model.Allergies ?? "Ninguna registrada")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a> <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
