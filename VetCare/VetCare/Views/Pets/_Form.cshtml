@model VetCare.Models.Pet
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label">Nombre</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="OwnerId" class="form-label">Propietario</label><select asp-for="OwnerId" asp-items="ViewBag.OwnerId" class="form-select"><option value="">Seleccione...</option></select><span asp-validation-for="OwnerId" class="text-danger"></span></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Species" class="form-label">Especie</label><input asp-for="Species" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Breed" class="form-label">Raza</label><input asp-for="Breed" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Sex" class="form-label">Sexo</label><select asp-for="Sex" class="form-select"><option value="">Sin especificar</option><option>Macho</option><option>Hembra</option></select></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="BirthDate" class="form-label">Fecha de nacimiento</label><input asp-for="BirthDate" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Weight" class="form-label">Peso (kg)</label><input asp-for="Weight" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Color" class="form-label">Color</label><input asp-for="Color" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="Allergies" class="form-label">Alergias</label><textarea asp-for="Allergies" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Notes" class="form-label">Notas</label><textarea asp-for="Notes" class="form-control"></textarea></div><div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Activo</label></div>
