@model VetCare.Models.LoginViewModel
@{ ViewData["Title"] = "Acceso administrativo"; }
<div class="row justify-content-center py-5"><div class="col-md-5 col-lg-4"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3 text-center">VetCare</h1><p class="text-muted text-center">Acceso exclusivo del administrador</p><form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Email" class="form-label">Correo</label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Contraseña</label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Recordarme</label></div><button class="btn btn-primary w-100">Iniciar sesión</button></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
