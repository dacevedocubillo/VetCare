@model VetCare.Models.BookingViewModel
@{ ViewData["Title"] = "Solicitar cita"; Layout = "_PublicLayout"; }
<div class="row justify-content-center"><div class="col-lg-7"><h1>Solicitar una cita</h1><p class="text-muted">Complete los datos y la clínica recibirá la solicitud inmediatamente.</p><form method="post" class="card card-body shadow-sm"><div asp-validation-summary="ModelOnly" class="text-danger"></div><h2 class="h5">Sus datos</h2><div class="row"><div class="col-md-6 mb-3"><label asp-for="OwnerName" class="form-label">Nombre completo</label><input asp-for="OwnerName" class="form-control" /><span asp-validation-for="OwnerName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label">Teléfono</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div></div><div class="mb-3"><label asp-for="Email" class="form-label">Correo para confirmación y recordatorio</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><h2 class="h5 mt-2">Mascota y cita</h2><div class="row"><div class="col-md-4 mb-3"><label asp-for="PetName" class="form-label">Mascota</label><input asp-for="PetName" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Species" class="form-label">Especie</label><input asp-for="Species" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Breed" class="form-label">Raza</label><input asp-for="Breed" class="form-control" /></div></div><div class="mb-3"><label asp-for="ScheduledAt" class="form-label">Fecha y hora solicitada</label><input asp-for="ScheduledAt" class="form-control" /></div><div class="mb-3"><label asp-for="Reason" class="form-label">Motivo</label><textarea asp-for="Reason" class="form-control"></textarea></div><button class="btn btn-success">Enviar solicitud</button></form><div class="text-center mt-3"><a asp-controller="Account" asp-action="Login">Acceso administrativo</a></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
